# .env
# Change the RAW and PROCESSED paths to point to the desired root folder
RAW_DATA_DIR  = "insert_value_here"
PROCESSED_DATA_DIR  = "insert_value_here"
ZIP_DATA_DIR  = "insert_value_here"

# past dataset path examples
ARD100_RAW  = "insert_value_here"
ARD100_PROCESSED  = "insert_value_here"
NPS_RAW  = "insert_value_here"
NPS_PROCESSED  = "insert_value_here"

# GitHub credentials
GITHUB_PAT  = "insert_value_here"

# Hugging Face credentials
